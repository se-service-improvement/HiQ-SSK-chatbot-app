***REMOVED***"name": "Student Success: LANTITE Numeracy Bootcamp (on campus): Day 3",
***REMOVED***"eventType": "Study, research and learning",
***REMOVED***"eventTypeId": 31,
***REMOVED***"prerequisiteFormId": null,
***REMOVED***"start": "2026-01-30T10:00:00+10:00",
***REMOVED***"end": "2026-01-30T12:00:00+10:00",
***REMOVED***"publish": "2025-12-17T23:02:00+10:00",
***REMOVED***"expire": "2026-01-30T12:00:00+10:00",
***REMOVED***"isActive": true,
