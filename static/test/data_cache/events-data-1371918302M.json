***REMOVED***"name": "Student Success: LANTITE Numeracy Bootcamp (online): Day 3",
***REMOVED***"eventType": "Study, research and learning",
***REMOVED***"eventTypeId": 31,
***REMOVED***"prerequisiteFormId": null,
***REMOVED***"start": "2026-01-30T14:00:00+10:00",
***REMOVED***"end": "2026-02-06T15:30:00+10:00",
