***REMOVED***"name": "Welcome to Information Technology (incl. refreshments)",
***REMOVED***"eventType": "Orientation",
***REMOVED***"eventTypeId": 30,
***REMOVED***"prerequisiteFormId": null,
***REMOVED***"start": "2026-02-17T10:00:00+10:00",
