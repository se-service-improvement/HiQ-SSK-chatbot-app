***REMOVED***"name": "Drop-in Student Success: Career Help for Business and Law Students",
***REMOVED***"eventType": "Careers and professional development",
***REMOVED***"eventTypeId": 23,
***REMOVED***"prerequisiteFormId": null,
***REMOVED***"start": "2026-02-11T11:00:00+10:00",
