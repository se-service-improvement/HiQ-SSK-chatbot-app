***REMOVED***"name": "New to QUT - HiQ Session and Campus Tour: Kelvin Grove Campus",
***REMOVED***"eventType": "Orientation",
***REMOVED***"eventTypeId": 30,
***REMOVED***"prerequisiteFormId": null,
***REMOVED***"start": "2026-02-05T14:00:00+10:00",
