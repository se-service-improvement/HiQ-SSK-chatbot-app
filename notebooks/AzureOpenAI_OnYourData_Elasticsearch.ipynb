***REMOVED***"import math\n",
***REMOVED***"import numpy as np\n",
***REMOVED***"import pandas as pd\n",
***REMOVED***"import statistics\n",
***REMOVED***"from io import StringIO\n",
***REMOVED***"from time import sleep, perf_counter\n",
***REMOVED***"from urllib.request import urlopen\n",
***REMOVED***"\n",
***REMOVED***"\n",
***REMOVED***"class SampleCsvDatasets(object):\n",
***REMOVED***"***REMOVED***datasets = {\n",
***REMOVED***"***REMOVED***\"msmarco\": {\n",
***REMOVED***"***REMOVED******REMOVED***\"url\": \"https://github.com/mayya-sharipova/msmarco/raw/main/msmarco-passagetest2019-unique.tsv\",\n",
***REMOVED***"***REMOVED******REMOVED***\"fieldnames\": [\"id\", \"text\"],\n",
***REMOVED***"***REMOVED******REMOVED***\"delimiter\": \"\\t\"\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***def __init__(self):\n",
***REMOVED***"***REMOVED***self._values = {}\n",
***REMOVED***"***REMOVED***for name, config in self.datasets.items():\n",
***REMOVED***"***REMOVED******REMOVED***url = config.get(\"url\")\n",
***REMOVED***"***REMOVED******REMOVED***response = urlopen(url)\n",
***REMOVED***"***REMOVED******REMOVED***self._values[name] = self._create_dataframe(name, response.read().decode(\"utf-8\"))\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***def _create_dataframe(self, dataset_name, value):\n",
***REMOVED***"***REMOVED***return pd.read_csv(\n",
***REMOVED***"***REMOVED******REMOVED***StringIO(value),\n",
***REMOVED***"***REMOVED******REMOVED***delimiter=self.datasets.get(dataset_name).get(\"delimiter\"),\n",
***REMOVED***"***REMOVED******REMOVED***names=self.datasets.get(dataset_name).get(\"fieldnames\")\n",
***REMOVED***"***REMOVED***)\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***def get_dataframe(self, dataset_name, add_aoai_embeddings=False):\n",
***REMOVED***"***REMOVED***return self._values[name]\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***def get_dataframe_with_aoai_embeddings(\n",
***REMOVED***"***REMOVED***self,\n",
***REMOVED***"***REMOVED***dataset_name,\n",
***REMOVED***"***REMOVED***embedding_model_deployment_name,\n",
***REMOVED***"***REMOVED***text_column_name=\"text\",\n",
***REMOVED***"***REMOVED***embeddings_column_name=\"text_embedding.aoai_predicted_value\",\n",
***REMOVED***"***REMOVED***model_name=\"text-embedding-ada-002\"\n",
***REMOVED***"***REMOVED***):\n",
***REMOVED***"***REMOVED***df = self._values[dataset_name]\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***# 16 is the current maximum batch size for embeddings, so we'll partition the dataframe by 16 rows.\n",
***REMOVED***"***REMOVED***maximum_batch_size = 16\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***# This value can be manipulated if rate limiting errors occur while producing embeddings.\n",
***REMOVED***"***REMOVED***throttling_interval = 0.5\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***# Occasionally the server will become overloaded, so retrying can ensure success.\n",
***REMOVED***"***REMOVED***retry_count = 30\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***number_of_buckets = math.ceil(len(df) / maximum_batch_size)\n",
***REMOVED***"***REMOVED***partitions = np.array_split(df, number_of_buckets)\n",
***REMOVED***"***REMOVED***embeddings = []\n",
***REMOVED***"***REMOVED***request_times = []\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***start = perf_counter()\n",
***REMOVED***"***REMOVED***for partition in partitions:\n",
***REMOVED***"***REMOVED******REMOVED***success = False\n",
***REMOVED***"***REMOVED******REMOVED***for i in range(retry_count):\n",
***REMOVED***"***REMOVED******REMOVED***try:\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***request_start = perf_counter()\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***text_embedding_response = openai.Embedding.create(\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***deployment_id=embedding_model_deployment_name,\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***input=partition[text_column_name].tolist(),\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***api_version=\"2023-03-15-preview\"\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***)\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***embeddings.extend([result[\"embedding\"] for result in text_embedding_response[\"data\"]])\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***sleep(throttling_interval)\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***request_end = perf_counter()\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***request_times.append(request_end-request_start)\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***success = True\n",
***REMOVED***"\n",
***REMOVED***"***REMOVED******REMOVED***except Exception as e:\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***print(f\"Encountered the following exception when creating embeddings (retrying): {str(e)}\")\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***sleep(5)\n",
***REMOVED***"***REMOVED******REMOVED***\n",
***REMOVED***"***REMOVED******REMOVED***if not success:\n",
***REMOVED***"***REMOVED******REMOVED***raise Exception(\"Unable to generate embeddings (see previous error output for more information.)\")\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***end = perf_counter()\n",
***REMOVED***"***REMOVED***df[text_embeddings_column_name] == embeddings\n",
***REMOVED***"***REMOVED***print(f\"Average request time for {len(partition)} records: {statistics.mean(request_times)}\")\n",
***REMOVED***"***REMOVED***print(f\"Total time: {end-start}\")\n",
***REMOVED***"\n",
***REMOVED***"def create_index(\n",
***REMOVED***"***REMOVED***elastic_client,\n",
***REMOVED***"***REMOVED***index_name: str,\n",
***REMOVED***"***REMOVED*****properties\n",
***REMOVED***"):\n",
***REMOVED***"***REMOVED***mappings = {\n",
***REMOVED***"***REMOVED***\"properties\": properties\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"\n",
***REMOVED***"***REMOVED***# Clean up any previously created index with the same name\n",
***REMOVED***"***REMOVED***elastic_client.indices.delete(index=index_name, ignore_unavailable=True)\n",
***REMOVED***"\n",
***REMOVED***"***REMOVED***# Create the index\n",
***REMOVED***"***REMOVED***elastic_client.indices.create(index=index_name, mappings=mappings)\n",
***REMOVED***"\n",
***REMOVED***"\n",
***REMOVED***"def index_data(\n",
***REMOVED***"***REMOVED***elastic_client,\n",
***REMOVED***"***REMOVED***dataset_reader,\n",
***REMOVED***"***REMOVED***index_name\n",
***REMOVED***"):\n",
***REMOVED***"***REMOVED***# Use the bulk API to index data in chunks of 10000 documents\n",
***REMOVED***"***REMOVED***operations_chunks = []\n",
***REMOVED***"***REMOVED***chunk = []\n",
***REMOVED***"***REMOVED***max_operations_chunk_size = 10000\n",
***REMOVED***"***REMOVED***chunk_size = 0\n",
***REMOVED***"\n",
***REMOVED***"***REMOVED***for row in dataset_reader:\n",
***REMOVED***"\n",
***REMOVED***"***REMOVED***if chunk_size < max_operations_chunk_size:\n",
***REMOVED***"***REMOVED******REMOVED***chunk.append({\"index\": {\"_index\": index_name}})\n",
***REMOVED***"***REMOVED******REMOVED***chunk.append(row)\n",
***REMOVED***"***REMOVED******REMOVED***chunk_size += 1\n",
***REMOVED***"***REMOVED******REMOVED***\n",
***REMOVED***"***REMOVED***else:\n",
***REMOVED***"***REMOVED******REMOVED***operations_chunks.append(chunk)\n",
***REMOVED***"***REMOVED******REMOVED***chunk = []\n",
***REMOVED***"***REMOVED******REMOVED***chunk_size = 0\n",
***REMOVED***"\n",
***REMOVED***"***REMOVED***if len(chunk) > 0:\n",
***REMOVED***"***REMOVED***operations_chunks.append(chunk)\n",
***REMOVED***"\n",
***REMOVED***"***REMOVED***for chunk in operations_chunks:\n",
***REMOVED***"***REMOVED***elastic_client.bulk(index=index_name, operations=chunk, refresh=True)\n",
***REMOVED***"\n",
***REMOVED***"def chat_with_my_data(\n",
***REMOVED***"***REMOVED***chat_query,\n",
***REMOVED***"***REMOVED***aoai_deployment_name,\n",
***REMOVED***"***REMOVED***elasticsearch_endpoint,\n",
***REMOVED***"***REMOVED***elasticsearch_api_key,\n",
***REMOVED***"***REMOVED***index_name,\n",
***REMOVED***"***REMOVED*****embedding_config\n",
***REMOVED***"):\n",
***REMOVED***"***REMOVED***elasticsearch_embedding_model = embedding_config.get(\"elasticsearch_embedding_model\", None)\n",
***REMOVED***"***REMOVED***aoai_embedding_model = embedding_config.get(\"aoai_embedding_model\", None)\n",
***REMOVED***"***REMOVED***aoai_embedding_key = embedding_config.get(\"aoai_embedding_key\", None)\n",
***REMOVED***"***REMOVED***aoai_embedding_endpoint = None if not aoai_embedding_model and not aoai_embedding_key \\\n",
***REMOVED***"***REMOVED***else  f\"{openapi.api_base}/openai/deployments/{aoai_embedding_model}/embeddings?api-version=2023-03-15-preview\"\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***query_type = \"vector\" if (aoai_embedding_endpoint and aoai_embedding_key) or elasticsearch_embedding_model else \"simple\"\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***completion = openai.ChatCompletion.create(\n",
***REMOVED***"***REMOVED***messages=[\n",
***REMOVED***"***REMOVED******REMOVED***{\n",
***REMOVED***"***REMOVED******REMOVED***\"role\": \"user\",\n",
***REMOVED***"***REMOVED******REMOVED***\"content\": chat_query\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***],\n",
***REMOVED***"***REMOVED***dataSources=[\n",
***REMOVED***"***REMOVED******REMOVED***{\n",
***REMOVED***"***REMOVED******REMOVED***\"type\": \"Elasticsearch\",\n",
***REMOVED***"***REMOVED******REMOVED***\"parameters\": {\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***\"endpoint\": elasticsearch_endpoint,\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***\"encodedApiKey\": elasticsearch_api_key,\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***\"indexName\": index_name,\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***\"queryType\": query_type,\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***\"embeddingModelId\": elasticsearch_embedding_model,\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***\"embeddingEndpoint\":  aoai_embedding_endpoint,\n",
***REMOVED***"***REMOVED******REMOVED******REMOVED***\"embeddingKey\": aoai_embedding_key\n",
***REMOVED***"***REMOVED******REMOVED***\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"***REMOVED***],\n",
***REMOVED***"***REMOVED***deployment_id=aoai_deployment_name\n",
***REMOVED***"***REMOVED***)\n",
***REMOVED***"***REMOVED***print(completion.choices[0].message.content)"
   ]
  },
