***REMOVED***"Next, we'll configure the OpenAI client to make requests to our specific Azure OpenAI resource endpoint.  We need to create an instance of `requests.adapters.HTTPAdapter` to ensure that the request session URL used by the OpenAI client points to the correct Azure OpenAI resource URL for each request."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "13a59211",
   "metadata": {},
   "outputs": [],
   "source": [
***REMOVED***"from requests import Session\n",
***REMOVED***"from requests.adapters import HTTPAdapter\n",
***REMOVED***"\n",
***REMOVED***"class OnYourDataAdapter(HTTPAdapter):\n",
***REMOVED***"***REMOVED***def send(self, request, **kwargs):\n",
***REMOVED***"***REMOVED***request.url = f\"{openai.api_base}/openai/deployments/{chat_model_deployment_name}/extensions/chat/completions?api-version={openai.api_version}\"\n",
***REMOVED***"***REMOVED***return super().send(request, **kwargs)\n",
***REMOVED***"***REMOVED***\n",
***REMOVED***"\n",
***REMOVED***"session = Session()\n",
***REMOVED***"session.mount(\n",
***REMOVED***"***REMOVED***prefix=f\"{openai.api_base}/openai/deployments/{chat_model_deployment_name}\",\n",
***REMOVED***"***REMOVED***adapter=OnYourDataAdapter()\n",
***REMOVED***")\n",
***REMOVED***"\n",
***REMOVED***"openai.requestssession = session"
   ]
